# Dependencies
node_modules/

# Docusaurus build output and caches
site/build/
site/.docusaurus/
site/.cache-loader/

# Harness output: screenshots, axe results, gate state. All regenerated by running the checks.
audit/results/
audit/shots/
audit/.gate/

# Example clients
examples/rust/target/
examples/javascript/node_modules/
examples/python/__pycache__/
examples/python/.venv/

# Logs from backgrounded dev servers
*.log

# Editor and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local secrets. Nothing in this repository should ever need one, and this is here so an
# accidental copy of a wallet or node secret cannot be committed.
.env
.env.*
*.pem
*.key
.api_secret
.owner_api_secret
